# Podman Compose configuration for Immich
# Using variables defined at runtime

services:
  immich-server:
    container_name: immich_server
    image: ghcr.io/immich-app/immich-server:release
    volumes:
      - {{ immich_storage_path }}/library:/usr/src/app/upload:Z
    ports:
      - {{ immich_port | default(2283) }}:3001
    environment:
      - DB_HOSTNAME=immich_postgres
      - PUID={{ immich_uid | default(ansible_user_uid | default(1000)) }}
      - PGID={{ immich_gid | default(ansible_user_gid | default(1000)) }}
      # ... other environment variables ...

  immich-postgres:
    container_name: immich_postgres
    image: docker.io/tensorchord/pgvecto-rs:pg14-v0.2.0
    # ...
