# Podman Compose configuration for Syncthing
# Using variables defined at runtime

services:
  syncthing:
    container_name: syncthing
    image: docker.io/syncthing/syncthing:latest
    hostname: syncthing
    environment:
      - PUID={{ syncthing_uid | default(ansible_user_uid | default(1000)) }}
      - PGID={{ syncthing_gid | default(ansible_user_gid | default(1000)) }}
    volumes:
      - {{ syncthing_storage_path }}/data:/var/syncthing:Z
    ports:
      - {{ syncthing_web_port }}:8384
      - {{ syncthing_listen_port }}:22000
      - {{ syncthing_listen_port }}:22000/udp
